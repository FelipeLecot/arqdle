# Port the API and production site listen on.
PORT=3001

# Secret used to encrypt puzzle tokens. Set a long random value in production.
# Example: openssl rand -hex 32
PUZZLE_SECRET=change-me-to-a-long-random-string

# Time zone used to decide when the daily puzzle changes.
PUZZLE_TIMEZONE=America/Montevideo

# Day 1 of the daily puzzle.
DAILY_EPOCH=2026-11-16

# Seed for the deterministic daily order.
DAILY_SEED=arqdle-2026

# Public origin, used for canonical, Open Graph and sitemap URLs.
# Set this before a production build. No trailing slash.
# SITE_URL=https://your-domain.example

# Optional path to a JSON file that pins answers to dates.
# DAILY_SCHEDULE=server/data/daily.json

# Optional descriptive User-Agent for Wikimedia image lookups.
# Include a contact URL or email if you deploy this publicly.
# WIKIMEDIA_USER_AGENT=Arqdle/1.0 (https://example.com; you@example.com)
