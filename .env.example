# Server port.
PORT=3001

# Public origin used for canonical, Open Graph and sitemap URLs.
# Set this before a production build. No trailing slash.
# SITE_URL=https://your-domain.example

# Postgres. The values below match compose.yaml for local development.
# In production use the EC2 instance, for example:
# DATABASE_URL=postgres://arqdle:password@ec2-host:5432/arqdle
DATABASE_URL=postgres://arqdle:arqdle_dev_password@localhost:5432/arqdle

# disable | require | verify-full. Default: disable for localhost, require otherwise.
# Use verify-full with DATABASE_CA_CERT for a production database.
# DATABASE_SSL=disable
# DATABASE_CA_CERT=/path/to/ec2-ca.pem

# Run pending SQL migrations when the server starts.
DB_AUTO_MIGRATE=true

# Session cookie lifetime. The session slides forward while it is used.
SESSION_TTL_DAYS=30
# Defaults to true when NODE_ENV=production. Set false only for plain HTTP.
# COOKIE_SECURE=false
# COOKIE_DOMAIN=example.com

# Google OAuth. Leave both empty to hide the sign-in button.
# Authorized redirect URI in Google Cloud:
#   http://localhost:3001/api/auth/google/callback
#   https://your-domain.example/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Private analytics. Add Google account emails, or use a bearer token for scripts.
# ADMIN_EMAILS=you@example.com
# ADMIN_TOKEN=change-me-to-a-long-random-token

# Daily puzzle.
PUZZLE_TIMEZONE=America/Montevideo
DAILY_EPOCH=2026-11-16
DAILY_SEED=arqdle-2026
# DAILY_SCHEDULE=server/data/daily.json

# Optional descriptive User-Agent for Wikimedia image lookups.
# WIKIMEDIA_USER_AGENT=Arqdle/1.0 (https://your-domain.example; you@example.com)

# Age limit for removing old empty guest profiles.
# GUEST_RETENTION_DAYS=90
